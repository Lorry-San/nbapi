# File path: /etc/systemd/system/nbapi.service
# sudo systemctl daemon-reload
# sudo systemctl start nbapi
# sudo systemctl enable nbapi
# sudo systemctl status nbapi
[Unit]
Description=NBAPI Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/nbapi  # 注意修改路径
ExecStart=/path/to/nbapi/nbapi --port 3000 --log-dir /path/to/nbapi/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
