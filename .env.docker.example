NEW_API_IMAGE=ghcr.io/lorry-san/nbapi:custom
NEW_API_CONTAINER=nbapi-new-api
APP_PORT=3000
TZ=Asia/Shanghai
NODE_NAME=nbapi-node-1

# Used by docker-compose.github.yml. Override this if you push to a different fork/branch.
NEW_API_BUILD_CONTEXT=https://github.com/Lorry-San/nbapi.git#codex/admin-usage-export-docker

# Change these before deployment. Keep values URL-safe, or URL-encode them in SQL_DSN/REDIS_CONN_STRING.
POSTGRES_PASSWORD=change_me_postgres_password
REDIS_PASSWORD=change_me_redis_password
SESSION_SECRET=change_me_to_a_long_random_session_secret
